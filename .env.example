# 复制为 .env（与本 docker-compose.yml 同目录；.gitignore 已排除 .env）
# ─────────────────────────────────────────────────────────────
# 1) Docker 网络与依赖容器（NGINX / PG / Meili 与本分组共用的那套网络）
DOCKER_NETWORK=portal-net          # docker network ls 查看实际网络名
PG_HOST=postgres                   # 你的 PG 容器名 / 服务名
PG_DB=portal
PG_USER=portal
PG_PASSWORD=CHANGEME
MEILI_HOST=meilisearch             # 你的 Meili 容器名 / 服务名
MEILI_MASTER_KEY=CHANGEME          # 与 Meili 容器启动时的 master key 一致

# 2) 引导管理员（仅当库内没有任何用户时创建）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGEME  # 必须改掉默认口令

# 3) 站点与安全
PUBLIC_ORIGIN=https://portal.example.com   # 对外访问地址（HTTPS）
COOKIE_SECURE=true                         # HTTPS 下必须为 true（Session cookie 仅经 HTTPS 传输）
# 上传上限默认 8GB（服务端 MAX_UPLOAD_GB，如需调整在 compose environment 里加一行）
