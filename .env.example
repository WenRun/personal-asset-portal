# 复制为 .env（与本 docker-compose.yml 同目录；.gitignore 已排除 .env，切勿提交）
# 每个参数都标了「怎么取值」；改完 .env 后执行 docker compose up -d 生效（改口令类需重建容器）。
# ─────────────────────────────────────────────────────────────────────────────

# ── 1) Docker 网络与依赖容器 ─────────────────────────────────────────────────
# portal 三个服务（server/worker/web）要接入 NGINX/PG/Meili 所在的那个 Docker 网络，
# 否则互相解析不到容器名。取值：在 NAS 上执行 docker network ls，找你 NGINX 容器所在的网络名。
DOCKER_NETWORK=portal-net

# PG 容器的名称或网络别名（docker ps 看 NAMES 列；填错 server 起不来报连不上库）
PG_HOST=postgres

# portal 专用库名 / 用户名（提前用 SQL 建好，见部署指南第 2 步）
PG_DB=portal
PG_USER=portal

# 上面 PG_USER 对应的口令（自定义强口令；与建用户时保持一致）
PG_PASSWORD=CHANGEME

# Meili 容器的名称或网络别名
MEILI_HOST=meilisearch

# Meili 的 master key：必须与 Meili 容器启动时设置的一致（不一致时搜索不可用）。
# 取值：docker inspect <meili容器名> | grep -i MEILI_MASTER_KEY
MEILI_MASTER_KEY=CHANGEME

# ── 2) 引导管理员 ────────────────────────────────────────────────────────────
# 仅当数据库里没有任何用户时，server 首次启动会用它创建管理员账号；之后改这里不影响已有账号。
BOOTSTRAP_ADMIN_USERNAME=admin

# 管理员初始口令：务必改掉占位值（登录后也可在系统里再改）
BOOTSTRAP_ADMIN_PASSWORD=CHANGEME

# ── 3) 站点与安全 ────────────────────────────────────────────────────────────
# 对外访问地址（NGINX 站点的访问入口；用于 CORS 等。同源部署下正常情况不参与，但建议填对）
# 局域网 HTTP 示例：http://192.168.31.31:8080；上 HTTPS 后改为 https://域名
PUBLIC_ORIGIN=http://192.168.31.31:8080

# Session cookie 是否仅经 HTTPS 传输。
# ⚠️ 纯局域网 HTTP 访问必须填 false——true 时浏览器会丢弃 cookie，表现为登录后立刻变未登录；
#    上 HTTPS（反代加证书）后再改回 true 并 docker compose up -d 重建。
COOKIE_SECURE=false

# ── 可选：不填走服务端默认值 ────────────────────────────────────────────────
# 上传单文件上限（GB），服务端默认 8。若调整，需与 NGINX 的 client_max_body_size 同步改。
# MAX_UPLOAD_GB=8
# 会话有效期（天），默认 30
# SESSION_TTL_DAYS=30
# worker 并发数，默认 2（NAS 性能充裕可加到 3-4）
# WORKER_CONCURRENCY=2

# ── 4) 图书元数据刮削（worker 联网补齐作者/出版社/ISBN/简介/封面） ────────────
# 总开关。true=书籍入库后自动查 Google Books 补缺失信息（豆瓣评分等第二期）；
# false=完全不外呼。NAS 容器出不了外网时填 false，否则刮削任务会反复超时失败堆在任务中心。
# 验证 NAS 能否出网：docker run --rm curlimages/curl -sS -m 8 https://www.googleapis.com
SCRAPE_ENABLED=true
# 单次外部请求超时秒数（默认 15）。NAS 到 Google 延迟高可加大到 30；设太小封面下载会频繁失败
SCRAPE_TIMEOUT_SECONDS=15
# 出站代理（可选，默认直连）。NAS 直连不了 Google 时填内网代理，如 http://192.168.31.5:7890；
# 填错地址的后果与不出网一样：任务超时失败。仅 worker 容器使用，不影响其他服务。
# SCRAPE_PROXY_URL=
# Google Books API key（可选但强烈建议填）。不填时走按 IP 共享的匿名配额——家用宽带/NAS 的
# 出口 IP 常被陌生人用光，表现为刮削任务报 429 Quota exceeded。
# 申请（免费，约 5 分钟）：console.cloud.google.com 新建项目 → 「API 和服务」启用 Books API →
# 「凭据」创建 API 密钥复制过来。配 key 后独立配额 1000 次/天（够全库刮几轮）。
# 填错 key 的后果：所有刮削任务失败，任务中心 last_error 显示 400 keyInvalid。
# SCRAPE_GOOGLE_BOOKS_KEY=
# 豆瓣刮削（第二期，默认开启）。中文书的评分/丛书/中文简介/封面以豆瓣为准（国内直连，
# 不走上面的代理——代理是海外出口，访问豆瓣反而更容易被风控）；内置限速约 1 次/秒。
# NAS 必须能直连国内网站（能打开 book.douban.com 即可）。想只用 Google 时改 false
# SCRAPE_DOUBAN_ENABLED=true
