# 复制为 .env 使用
# 数据库：复用本机通用 postgres-dev 容器（宿主 5432），portal 库需预先创建：
#   docker exec postgres-dev psql -U postgres -c "CREATE DATABASE portal"
# 口令请改成 postgres-dev 容器的实际 postgres 口令
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/portal

# 搜索：独立通用容器 meilisearch-dev（宿主 7700，密钥 dev-meili-master-key）
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key
MEILI_ENABLED=true

# 数据根目录（library 资源根 + uploads 暂存 都在其下）
DATA_ROOT=./data

# 首次启动引导创建的管理员（库内无任何用户时生效）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin1234

SESSION_TTL_DAYS=30
MAX_UPLOAD_GB=8
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
WORKER_CONCURRENCY=2
