# 复制为 .env 使用
# 数据库：复用本机通用 postgres-dev 容器（宿主 5432），portal 库需预先创建：
#   docker exec postgres-dev psql -U postgres -c "CREATE DATABASE portal"
# 口令请改成 postgres-dev 容器的实际 postgres 口令
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/portal

# 搜索：独立通用容器 meilisearch-dev（宿主 7700）
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key   # 与 meilisearch-dev 容器启动参数一致
MEILI_ENABLED=true                      # false 时搜索降级为空结果（Meili 不可达也不阻塞启动）

# 数据根目录（library 资源根 + uploads 暂存 都在其下）
DATA_ROOT=./data

# 首次启动引导创建的管理员（库内无任何用户时生效）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin1234      # 本地开发默认口令；生产 compose 强制注入不允许默认值

SESSION_TTL_DAYS=30                     # 登录会话有效期（天）
MAX_UPLOAD_GB=8                         # 上传单文件上限（GB）
COOKIE_SECURE=false                     # 本地 HTTP 开发固定 false（true 会被浏览器丢弃）
FRONTEND_ORIGIN=http://localhost:5173   # Vite 开发服务器地址（CORS 允许来源；生产同源无 CORS）
WORKER_CONCURRENCY=2                    # worker 并发数（另开进程 python -m app.core.worker）
